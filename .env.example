# ==============================================================
# LearnLens Environment Configuration
# ==============================================================

# AI Provider Configuration ('demo' | 'gemma' | 'openweight' | 'hybrid')
# Default is 'demo' for instant out-of-the-box hackathon testing with pre-parsed multimodal sources.
AI_PROVIDER=demo

# Track 2: Gemma 4 Multimodal Configuration
# Supported official models: google/gemma-4-31B-it, gemma-4-26b-it, gemma-4-e4b-it
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=google/gemma-4-31B-it
GEMMA_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# Track 1: Open-Source AI Reasoning Layer
# Supported open-weight models: deepseek-ai/DeepSeek-R1, Qwen/Qwen2.5-Coder-32B-Instruct, meta-llama/Llama-3.3-70B-Instruct, google/gemma-4-31B-it
OPEN_SOURCE_MODEL=deepseek-ai/DeepSeek-R1
OPEN_SOURCE_API_BASE=http://localhost:11434/v1
OPEN_SOURCE_API_KEY=ollama

# Database (Optional Supabase / PostgreSQL configuration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learnlens

# Server Ports
PORT=4000
VITE_API_URL=http://localhost:4000
